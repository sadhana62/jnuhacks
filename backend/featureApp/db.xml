          <mxGeometry x="980" y="210" width="260" height="140" as="geometry"/>
        </mxCell>

        <!-- timetables -->
        <mxCell id="timetables" value="timetables&#10;----------------&#10;PK id&#10;FK class_id → classes.id&#10;section_name&#10;timetable_data (JSON)"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;"
