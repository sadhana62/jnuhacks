          <mxGeometry x="1020" y="640" width="260" height="160" as="geometry"/>
        </mxCell>

        <!-- Relationships -->
        <mxCell id="r1" style="endArrow=block;html=1;" edge="1" parent="1" source="student" target="student_session"/>
        <mxCell id="r2" style="endArrow=block;html=1;" edge="1" parent="1" source="student" target="student_interest"/>
        <mxCell id="r3" style="endArrow=block;html=1;" edge="1" parent="1" source="student" target="seat_assignments"/>

        <mxCell id="r4" style="endArrow=block;html=1;" edge="1" parent="1" source="classes" target="sections"/>
        <mxCell id="r5" style="endArrow=block;html=1;" edge="1" parent="1" source="classes" target="class_subjects"/>
        <mxCell id="r6" style="endArrow=block;html=1;" edge="1" parent="1" source="classes" target="timetables"/>

      </root>
    </mxGraphModel>
