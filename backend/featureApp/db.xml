        <!-- classes -->
        <mxCell id="classes" value="classes&#10;----------------&#10;PK id&#10;name (UNIQUE)"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;"
                vertex="1" parent="1">
          <mxGeometry x="700" y="40" width="240" height="120" as="geometry"/>
