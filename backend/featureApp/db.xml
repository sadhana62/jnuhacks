<mxfile host="app.diagrams.net">
  <diagram name="School Management DB">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- student -->
        <mxCell id="student" value="student&#10;----------------&#10;PK id&#10;name&#10;father_name&#10;mother_name&#10;dob&#10;gender&#10;street&#10;city&#10;state&#10;zip&#10;phone&#10;email&#10;blood_group&#10;password"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;"
                vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="260" height="340" as="geometry"/>
        </mxCell>

        <!-- student_session -->
        <mxCell id="student_session" value="student_session&#10;----------------&#10;FK stu_id → student.id&#10;class&#10;section"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;"
                vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="260" height="160" as="geometry"/>
        </mxCell>

        <!-- student_interest -->
        <mxCell id="student_interest" value="student_interest&#10;----------------&#10;FK stu_id → student.id&#10;interest"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;"
                vertex="1" parent="1">
          <mxGeometry x="360" y="230" width="260" height="140" as="geometry"/>
        </mxCell>

        <!-- seat_assignments -->
        <mxCell id="seat_assignments" value="seat_assignments&#10;----------------&#10;PK id&#10;FK stu_id → student.id&#10;seat_number&#10;date_assigned"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;"
                vertex="1" parent="1">
          <mxGeometry x="360" y="410" width="260" height="180" as="geometry"/>
